{
  "datasets": [
    {
      "name": "depression_screening",
      "displayName": "Depression Screening Data",
      "config": {
        "version": "1.1",
        "source": "workspace.default.depression_screening_report",
        "dimensions": [
          {
            "name": "Last_Name",
            "expr": "Last_Name",
            "displayName": "Last Name"
          },
          {
            "name": "First_Name",
            "expr": "First_Name",
            "displayName": "First Name"
          },
          {
            "name": "MRN",
            "expr": "MRN",
            "displayName": "Medical Record Number"
          },
          {
            "name": "DOB",
            "expr": "DOB",
            "displayName": "Date of Birth"
          },
          {
            "name": "Sex_At_Birth",
            "expr": "Sex_At_Birth",
            "displayName": "Sex at Birth"
          },
          {
            "name": "Appointment_Date_Time",
            "expr": "Appointment_Date_Time",
            "displayName": "Appointment Date/Time"
          },
          {
            "name": "Appointment_Location",
            "expr": "Appointment_Location",
            "displayName": "Appointment Location"
          },
          {
            "name": "Appointment_Provider_Resource",
            "expr": "Appointment_Provider_Resource",
            "displayName": "Provider"
          },
          {
            "name": "Depression_Screening_Completed",
            "expr": "Depression_Screening_Completed",
            "displayName": "Screening Completed"
          },
          {
            "name": "Screening_Tool_Used",
            "expr": "Screening_Tool_Used",
            "displayName": "Screening Tool"
          },
          {
            "name": "Plan_Date",
            "expr": "Plan_Date",
            "displayName": "Plan Date"
          }
        ],
        "measures": [
          {
            "name": "Total_Patients",
            "expr": "COUNT(DISTINCT MRN)",
            "displayName": "Total Patients"
          },
          {
            "name": "Patient_Count",
            "expr": "COUNT(1)",
            "displayName": "Patient Count"
          },
          {
            "name": "Screenings_Completed_Count",
            "expr": "COUNT(CASE WHEN Depression_Screening_Completed = 'Yes' THEN 1 END)",
            "displayName": "Screenings Completed"
          },
          {
            "name": "Screenings_Needed_Count",
            "expr": "COUNT(CASE WHEN Depression_Screening_Completed = 'No' THEN 1 END)",
            "displayName": "Screenings Needed"
          }
        ]
      }
    }
  ],
