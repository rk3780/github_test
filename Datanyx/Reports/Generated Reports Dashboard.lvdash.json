{
  "datasets": [
    {
      "name": "b5be127f",
      "displayName": "Reports Dataset",
      "queryLines": [
        "SELECT \r\n",
        "    report_id,\r\n",
        "    report_category,\r\n",
        "    report_title,\r\n",
        "    generated_by,\r\n",
        "    generated_on,\r\n",
        "    report_type,\r\n",
        "    schedule_name,\r\n",
        "    status,\r\n",
        "    CASE \r\n",
        "        WHEN download_link = 'link' THEN '📥' \r\n",
        "    END AS download_link,\r\n",
        "    CASE \r\n",
        "        WHEN delete_flag = 'No' THEN '🗑️' \r\n",
        "    END AS delete_flag\r\n",
        "FROM workspace.default.reports\r\n",
        "limit :row_limit;"
      ],
      "parameters": [
        {
          "displayName": "row_limit",
          "keyword": "row_limit",
          "dataType": "INTEGER",
          "defaultSelection": {
            "values": {
              "dataType": "INTEGER",
              "values": [
                {
                  "value": "10"
                }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "fe4a00db",
      "displayName": "Scheduled Reports Dataset",
      "queryLines": [
        "SELECT\r\n",
        "    report_id,\r\n",
        "    report_category,\r\n",
        "    report_title,\r\n",
        "    schedule_name,\r\n",
        "    scheduled_by,\r\n",
        "    scheduled_time,\r\n",
        "    frequency,\r\n",
        "    updated_on_by,\r\n",
        "    last_delivery,\r\n",
        "    case when pause_schedule = 'Pause' then '▶️ Pause'\r\n",
        "        when pause_schedule = 'Paused' then '⏸ Paused' END as pause_schedule,\r\n",
        "    '▶️ Generate' as action,           \r\n",
        "    '✏️' as edit_flag,        \r\n",
        "    '🗑️' as delete_flag       \r\n",
        "FROM workspace.default.scheduled_reports\r\n",
        "limit :row_limit;"
      ],
      "parameters": [
        {
          "displayName": "row_limit",
          "keyword": "row_limit",
          "dataType": "INTEGER",
          "defaultSelection": {
            "values": {
              "dataType": "INTEGER",
              "values": [
                {
                  "value": "10"
                }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "233545b7",
      "displayName": "Combined Dataset",
      "queryLines": [
        "SELECT \r\n",
        "    report_id,\r\n",
        "    report_category,\r\n",
        "    report_title,\r\n",
        "    generated_by,\r\n",
        "    generated_on,\r\n",
        "    report_type,\r\n",
        "    schedule_name,\r\n",
        "    status,\r\n",
        "    CASE \r\n",
        "        WHEN download_link = 'link' THEN '📥' \r\n",
        "    END AS download_link,\r\n",
        "    CASE \r\n",
        "        WHEN delete_flag = 'No' THEN '🗑️' \r\n",
        "    END AS delete_flag\r\n",
        "FROM workspace.default.reports\r\n",
        "where :switch_to = 'Generated Reports'\r\n",
        "limit :row_limit;\r\n",
        "\r\n",
        "\r\n",
        "\r\n",
        "\r\n",
        "SELECT\r\n",
        "    report_id,\r\n",
        "    report_category,\r\n",
        "    report_title,\r\n",
        "    schedule_name,\r\n",
        "    scheduled_by,\r\n",
        "    scheduled_time,\r\n",
        "    frequency,\r\n",
        "    updated_on_by,\r\n",
        "    last_delivery,\r\n",
        "    case when pause_schedule = 'Pause' then '▶️ Pause'\r\n",
        "        when pause_schedule = 'Paused' then '⏸ Paused' END as pause_schedule,\r\n",
        "    '▶️ Generate' as action,           \r\n",
        "    '✏️' as edit_flag,        \r\n",
        "    '🗑️' as delete_flag       \r\n",
        "FROM workspace.default.scheduled_reports\r\n",
        "where :switch_to = 'Practice Scheduled Reports'\r\n",
        "limit :row_limit;"
      ],
      "parameters": [
        {
          "displayName": "row_limit",
          "keyword": "row_limit",
          "dataType": "INTEGER",
          "defaultSelection": {
            "values": {
              "dataType": "INTEGER",
              "values": [
                {
                  "value": "10"
                }
              ]
            }
          }
        },
        {
          "displayName": "switch_to",
          "keyword": "switch_to",
          "dataType": "STRING",
          "defaultSelection": {
            "values": {
              "dataType": "STRING",
              "values": [
                {
                  "value": "Generated Reports"
                }
              ]
            }
          }
        }
      ]
    }
